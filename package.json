{
  "name": "wme-place-harmonizer-row-edition",
  "version": "0.1.1",
  "description": "TypeScript userscript for Waze Map Editor ROW Edition place harmonization",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-userscript.mjs dev --watch",
    "build": "npm run build:dev && npm run build:prod",
    "build:dev": "node scripts/build-userscript.mjs dev",
    "build:beta": "node scripts/build-userscript.mjs beta",
    "build:prod": "node scripts/build-userscript.mjs stable",
    "lint": "eslint src tests scripts/build-userscript.mjs",
    "check": "npm run lint && npm run test",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node tests/run-tests.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
