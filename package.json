{
  "name": "wme-place-harmonizer-row-edition",
  "version": "0.1.1",
  "description": "TypeScript userscript for Waze Map Editor ROW Edition place harmonization",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node tests/run-tests.ts",
    "release:dev": "npm run build:dev",
    "release:stable": "npm run build:prod"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
